{
  "name": "spammy",
  "version": "0.0.0",
  "private": true,
  "description": "Spammy \u2014 turn a WhatsApp group export into an animated award ceremony.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @spammy/server --filter @spammy/web dev",
    "start": "pnpm dev",
    "build": "pnpm --filter @spammy/web build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
